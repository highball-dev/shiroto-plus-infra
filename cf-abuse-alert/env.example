# ============================================================
# cf-abuse-alert (SwipeDrama): copy to .env IN THIS FOLDER for local runs
# (a .env in a parent folder is not read; ENV_FILE=<path> overrides), or
# paste the non-secret part into the Environment tab of the
# Northflank service. The three secrets go into a Northflank
# Secret Group, not here.
# ============================================================

# --- Secrets (required) ---
# A token for THIS service only: Zone > Analytics > Read, zone swipedrama.com only.
# (CLOUDFLARE_API_TOKEN / CLOUDFLARE_ZONE_ID, the names used by the metrics proxy, also work.)
CF_API_TOKEN=
# Zone ID of swipedrama.com (dashboard > zone Overview > API > Zone ID)
CF_ZONE_TAG=
# Incoming webhook of the PRIVATE alert channel. The URL is a credential.
SLACK_WEBHOOK_URL=

# --- Scope (required) ---
# Shown in every message: PROD or NON-PROD.
ENVIRONMENT_LABEL=NON-PROD
# Never empty: prod and staging share the zone, the service refuses to watch all of it.
#   prod:     api.swipedrama.com,swipedrama.com
#   non-prod: stg-api.swipedrama.com,stg.swipedrama.com
MONITOR_HOSTS=stg-api.swipedrama.com,stg.swipedrama.com
# IPs / CIDRs that never alert (office, QA, load-test runner, uptime monitors). IPv4 + IPv6.
ALLOWLIST_IPS=
# Networks whose VOLUME is expected (web SSR runs on Hetzner, AS24940). They are exempt from the
# flood / crawl / enumeration rules only: a scan or an injection attempt from them still alerts.
# Prefer ALLOWLIST_IPS when the egress IPs are stable; an ASN is shared with strangers, and it is
# only known for IPs with traffic in the current window (the 60-minute rules can miss it).
# TRUSTED_ASNS=24940

# --- Slack ---
# Appended to CRITICAL alerts: <!here>, <!channel>, <@U0123ABCD> or <!subteam^S0123ABCD>.
# SLACK_CRITICAL_MENTION=
# Time zone of the window shown in alerts: NAME+H (JST+9, ICT+7, UTC+0).
# DISPLAY_TIMEZONE=JST+9
# Post "started" when the service boots (at most once per 10 minutes).
# STARTUP_MESSAGE=true
# With the account id the link opens the zone's Security Events directly.
# CF_ACCOUNT_ID=
# CF_ZONE_NAME=swipedrama.com
# DASHBOARD_URL=              # full override

# --- Behaviour ---
# Start with true: the full pipeline runs, logs masked summaries, posts nothing.
# Booleans are true/false (1/0, yes/no, on/off); anything else is a configuration error.
DRY_RUN=true
# 2 = every count threshold doubled (0.1 to 100). Use it for the first weeks on prod, then tune rules.py.
# THRESHOLD_MULTIPLIER=1
# Rules to switch off, by id (see README "Rules"). Example: a rule that is too noisy until tuned.
# An unknown id is a configuration error.
# DISABLED_RULES=
# HEARTBEAT_HOUR_UTC=0        # daily "is watching" message; 0 UTC = 09:00 JST
# LOG_LEVEL=INFO

# --- Paths ---
# Paths never counted by the per-IP rules: provider webhooks, callbacks, health checks, static
# assets. Plain entries are prefixes; "*" matches anything (/api/movies/*/metadata).
# Setting this REPLACES the built-in list (endpoints.py), so copy that list and add to it.
# EXCLUDED_PATH_PREFIXES=
# What counts as an API request for high_api_requests.
# API_PATH_PREFIXES=/api/
# Methods counted by the auth / signup / rewards / unlock / upload rules.
# SENSITIVE_METHODS=POST,PUT,PATCH,DELETE

# --- Webhook monitoring ---
# Paths treated as webhooks/callbacks. Default: the list in endpoints.py.
# WEBHOOK_PREFIXES=
# Source profiles (ASN, UA, known IPs per webhook), built by
#   python cf_webhook_baseline.py --days 30
# and reviewed by hand. No file = only webhook_rejected is active.
# WEBHOOK_SOURCES_FILE=/app/webhook_sources.json
# A NEW IP inside a provider's network alerts only when it keeps sending:
# WEBHOOK_NEW_IP_BURST=20     # calls in one window
# WEBHOOK_NEW_IP_STREAK=3     # consecutive windows with traffic
# WEBHOOK_NEW_IP_HOURLY=50    # calls over the last 60 minutes

# --- Media / crawl detection ---
# Hosts serving images/video THROUGH Cloudflare (Bunny CDN traffic is not visible here).
# Leave both empty and media_requests is off.
# MEDIA_HOSTS=
# MEDIA_PATH_PREFIXES=
# SUSTAINED_WINDOW_MINUTES=60 # window of the slow-crawl and hourly-purchase rules

# --- Window & volume ---
# INGEST_LAG_MINUTES=3        # measure with `python cf_probe.py`
# WINDOW_MINUTES=5            # also the tick period; must divide 60
# DEDUPE_TTL_SECONDS=1800     # one alert per (IP, rule) per 30 min; an escalation resends
# MAX_ALERTS_PER_RUN=10       # more IPs (or webhook callers) than this are folded into one summary message
# MAX_CANDIDATES=50           # IPs fetched in detail per tick
# GRAPHQL_TIMEOUT_SECONDS=15

# --- Cloudflare values to verify on the real zone (cf_probe.py prints them) ---
# BLOCK_ACTIONS=block,challenge,jschallenge,managed_challenge,connection_close,force_connection_close,challenge_failed,jschallenge_failed
# RATE_LIMIT_SOURCES=ratelimit

# --- Health check ---
# Set to serve GET /healthz (liveness) and GET /readyz. Empty = no port is opened.
# PORT=8080

# --- State ---
# Empty = memory only (a restart re-sends, once, what is still over a threshold).
# Point it at a Northflank volume to keep dedupe state across restarts.
# STATE_FILE=/data/state.json
